#!/usr/bin/env bash
# This script is creating a PID file and displaying messages depending on the signals it receives
handle_sigint()
{
    echo "Y U no love me?!"
}
handle_sigterm()
{
    echo "I hate the kill command"
    rm /var/run/myscript.pid
    exit
}
handle_sigquit()
{
    rm /var/run/myscript.pid
    exit
}
echo "$$" > /var/run/myscript.pid
trap handle_sigint SIGINT
trap handle_sigterm SIGTERM
trap handle_sigquit SIGQUIT
while true
do
    echo "To infinity and beyond"
    sleep 2
done
